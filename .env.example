# ── Cubicle configuration ────────────────────────────────────────────────────
# `./install.sh` generates this file for you. Edit it by hand only if you know
# what you are changing, then run `docker compose up -d` to apply.

# Version tag used for every image this repository builds.
CUBICLE_VERSION=1.0.0

# ── Networking ───────────────────────────────────────────────────────────────
# Leave CUBICLE_DOMAIN empty for a local install (http://localhost:28080).
# Set it to a hostname whose A/AAAA record points at this machine and Caddy
# will obtain and renew a Let's Encrypt certificate automatically on boot.
CUBICLE_DOMAIN=
CUBICLE_ACME_EMAIL=

# Derived by install.sh — `:80` locally, the bare hostname in domain mode.
CUBICLE_SITE_ADDRESS=:80
CUBICLE_PUBLIC_URL=http://localhost:28080

# Host ports. Domain mode must use 80/443 so ACME's HTTP-01 challenge works.
# High and uncommon on purpose: below 10000 is crowded, and 32768+ is the
# range Linux hands out to outbound connections.
CUBICLE_HTTP_PORT=28080
CUBICLE_HTTPS_PORT=28443

# ── Secrets (generated — never commit a real .env) ───────────────────────────
# POSTGRES_PASSWORD  control-plane database password
# CUBICLE_SECRET_KEY session cookie signing key
# CUBICLE_MASTER_KEY root key for envelope-encrypted secrets. Losing it makes
#                    every stored secret unrecoverable; back it up.
POSTGRES_PASSWORD=
CUBICLE_SECRET_KEY=
CUBICLE_MASTER_KEY=

# ── Runtime ──────────────────────────────────────────────────────────────────
# Seconds an idle isolate stays warm before the last one is reclaimed and the
# function returns to zero.
CUBICLE_ISOLATE_IDLE_TTL=900
# Seconds of quiet before the pool starts giving back the extra isolates a
# burst created, one every reconcile pass. Lower reclaims memory sooner at the
# cost of more cold starts when traffic is spiky.
CUBICLE_ISOLATE_SCALEDOWN_WINDOW=60
CUBICLE_LOG_LEVEL=info
