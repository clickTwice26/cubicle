{
	# On a unix socket rather than off: the control plane reloads this config
	# every time an application's routing changes, and a reload goes through
	# the admin API. A socket inside the container has no port, is not on any
	# network, and is reachable only by an exec in this container — which is
	# what the control plane does over the Docker socket it already owns.
	admin unix//run/caddy-admin.sock
	# Written by install.sh: either an `email <address>` line for the ACME
	# account, or nothing at all. Certificates are issued either way.
	import /etc/caddy/conf.d/*.caddyfile
	servers {
		trusted_proxies static private_ranges
	}
}

# Applications. Written by the control plane on every deploy — one site block
# per hostname, each with its own certificate. The file may not exist yet on a
# fresh install, and an import that matches nothing is not an error.
import /etc/caddy/apps/*.caddyfile

# CUBICLE_SITE_ADDRESS is `:80` for a local install and the bare hostname
# (e.g. cubicle.example.com) when a domain is configured — in that case Caddy
# obtains and renews the certificate itself, with no extra configuration.
{$CUBICLE_SITE_ADDRESS} {
	# Compression is opt-in by content type rather than the default `text/*`,
	# because that default also matches text/event-stream — and a compressed
	# event stream is a buffered one. The live log tail and the activity
	# dashboard would sit there receiving nothing.
	encode {
		zstd
		gzip
		match {
			header Content-Type text/html*
			header Content-Type text/plain*
			header Content-Type text/css*
			header Content-Type text/javascript*
			header Content-Type text/xml*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xhtml+xml*
			header Content-Type application/wasm*
			header Content-Type image/svg+xml*
		}
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Control plane API, health and Prometheus metrics.
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /healthz {
		reverse_proxy api:8000
	}
	handle /metrics {
		reverse_proxy api:8000
	}

	# Function invocations. Two shapes reach the control plane:
	#   /<namespace>/<function>            → the cluster owning this hostname,
	#                                        or the default cluster
	#   /<cluster>/<namespace>/<function>  → that cluster, explicitly
	# Console paths are excluded, so neither can shadow the UI.
	@invoke {
		not path /console*
		not path /docs*
		not path /setup*
		not path /assets/*
		not path /fonts/*
		path_regexp fn ^/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)?/?$
	}
	handle @invoke {
		# Refused here rather than in the control plane, which is the only
		# place that can refuse it before the bytes are on this machine. The
		# API enforces the same ceiling itself, because this file is not the
		# only way in: anything on the function network reaches it directly.
		request_body {
			max_size 6MB
		}
		rewrite * /api/invoke{uri}
		reverse_proxy api:8000 {
			# Functions may legitimately run to their configured timeout.
			transport http {
				read_timeout 15m
			}
		}
	}

	# Console SPA.
	handle {
		reverse_proxy web:8080
	}
}
